# COPY VALUES INTO VERCEL AND YOUR EXISTING .env.local; DO NOT COMMIT REAL CREDENTIALS.
# Existing public Supabase client settings (already required by X Royal):
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Use either the anon key or publishable key. Client code checks these names in order:
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY
# Optional legacy technical admin alias; every additional admin signs in with their own email.
# These are never a list of admin users. Admin authorization is in public.admin_users.
XROYAL_ADMIN_USERNAME=admin
XROYAL_ADMIN_EMAIL=admin@example.com
NEXT_PUBLIC_SITE_URL=https://xroyalrentacar.me